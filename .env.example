# Copy to .env and fill in. Never commit the real file.

# Any node of the cluster (hostname or IP).
PROXMOX_HOST=pve1.example.com
# PROXMOX_PORT=8006

# API token in the form user@realm!tokenname, plus its secret.
# See docs/proxmox-setup.md for creating a least-privilege token.
PROXMOX_TOKEN_ID=mcp@pve!ops
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# TLS: keep verification on. For a self-signed cluster CA, point to it instead:
# PROXMOX_CA_BUNDLE=/etc/ssl/certs/pve-root-ca.pem
# PROXMOX_VERIFY_SSL=true

# read_only (default) | operator | admin
PROXMOX_ACCESS_TIER=read_only

# Append-only JSONL audit log. Defaults to stderr when unset.
# PROXMOX_AUDIT_LOG=/var/log/proxmox-ops-mcp/audit.jsonl
